# Copy this file to .streamlit/secrets.toml and fill in ONE option.
# secrets.toml is in .gitignore: never commit a real API key.

# --- Option A: Claude (Anthropic) ------------------------------------------
LLM_PROVIDER = "anthropic"
ANTHROPIC_API_KEY = "sk-ant-..."
LLM_MODEL = "claude-haiku-5-5"

# --- Option B: any OpenAI-compatible API -----------------------------------
# OpenAI:
# LLM_PROVIDER = "openai"
# OPENAI_API_KEY = "sk-..."
# LLM_MODEL = "gpt-4o-mini"
#
# Google Gemini (free tier key from aistudio.google.com):
# LLM_PROVIDER = "openai"
# OPENAI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# OPENAI_API_KEY = "your-gemini-key"
# LLM_MODEL = "gemini-2.5-flash"
#
# Local Ollama (no key, runs on your laptop):
# LLM_PROVIDER = "openai"
# OPENAI_BASE_URL = "http://localhost:11434/v1"
# LLM_MODEL = "llama3.1"
